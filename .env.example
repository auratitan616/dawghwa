# Base URL of a deployed Dawghwa API (https://github.com/titan717/dawghwa.api).
# Leave empty on the web to use same-origin /api (proxied in dev to DAWGHWA_API_DEV).
# Required for the Android build, which has no same-origin API.
VITE_API_BASE_URL=
# Public site origin, used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://dawghwa.app
# Dev/preview proxy target for /api
DAWGHWA_API_DEV=http://localhost:3100
